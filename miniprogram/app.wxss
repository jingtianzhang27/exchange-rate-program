page{background:#f5f7f8;color:#172c37;font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:28rpx}button{font-size:28rpx;border-radius:18rpx}button::after{border:0}.primary{background:#11695c;color:white}.muted{color:#647782;font-size:24rpx;line-height:1.7}.card{background:white;border-radius:24rpx;padding:32rpx;margin-bottom:24rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.section{font-size:32rpx;font-weight:600;margin-bottom:24rpx}.field{background:#f1f5f5;border-radius:14rpx;padding:20rpx;margin:14rpx 0}.warn{background:#fff0da;color:#855b17;padding:20rpx;border-radius:16rpx;margin-bottom:20rpx;font-size:24rpx}.error{color:#ad4036}.empty{text-align:center;padding:40rpx 10rpx;color:#74858c}.tag{font-size:22rpx;background:#e5f3ec;color:#126d56;border-radius:10rpx;padding:8rpx 14rpx}.small{font-size:24rpx}.divider{border-top:1rpx solid #edf1f2;margin:20rpx 0}
