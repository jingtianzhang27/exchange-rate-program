# This file documents names only; configure through secure server environment settings.
# The server reads process environment, and does not automatically load this file.
WX_APP_ID=wxfab79228c5d3d1a6
WX_APP_SECRET=
WX_TEMPLATE_ID=
# Example ONLY: replace field names with the exact approved template schema.
# Values supported: title, price, time, reason, bank, currency. Match field type/length requirements.
WX_TEMPLATE_MAPPING={"thing1":"title","amount2":"price","time3":"time","thing4":"reason"}
# Object storage snapshot backup (CloudRun console: 对象存储 → 存储配置).
# Leave COS_BUCKET empty to disable snapshots; the remaining values are optional.
COS_BUCKET=
COS_REGION=ap-shanghai
COS_BACKUP_PREFIX=backups/
BACKUP_INTERVAL_SECONDS=600
BACKUP_KEEP=24
# Optional OpenAI-compatible chat-completions endpoint; without it show statistics only.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
